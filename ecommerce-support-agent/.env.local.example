# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Sheets IDs
SHEET_ID_PRODUCTS=your_products_sheet_id
SHEET_ID_ORDERS=your_orders_sheet_id
SHEET_ID_BANK=your_bank_details_sheet_id

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_FILE=your-service-account-key.json

# Default Model
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
